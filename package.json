{
  "name": "dsh-cnb",
  "version": "0.10.0",
  "description": "CNB (cnb.cool) integration for DeepSeek Harness: QR sign-in, repositories, cloud-native workspaces, organization usage, one-click CNB AI gateway wiring into llm-pi-ai, and full auto-provisioning of a cloud-hosted gateway (built-in 11128/11288 content-risk adaptation).",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cnb",
    "cnb.cool",
    "workspace",
    "llm-gateway",
    "cloud-gateway",
    "auto-provision",
    "openai-compatible"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "LICENSE-cnb2api",
    "lib/cloud",
    "test/*.test.mjs",
    "test/run.mjs",
    "test/resolve-dsh.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useragent-1/dsh-cnb.git"
  },
  "homepage": "https://github.com/useragent-1/dsh-cnb#readme",
  "bugs": {
    "url": "https://github.com/useragent-1/dsh-cnb/issues"
  },
  "author": "useragent-1"
}
